{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/car-catalog-i18n/schemas/locale.schema.json",
  "title": "Locale translations",
  "type": "object",
  "additionalProperties": false,
  "required": ["makes", "models"],
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "\\S" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "pattern": "\\S" }
        }
      }
    }
  },
  "properties": {
    "makes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/entry" }
    },
    "models": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/entry" }
    }
  }
}
